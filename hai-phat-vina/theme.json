{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "780px", "wideSize": "1280px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "forest", "name": "Xanh Hải Phát", "color": "#163e35" },
        { "slug": "leaf", "name": "Xanh lá", "color": "#2f6b54" },
        { "slug": "sun", "name": "Vàng nắng", "color": "#f1c75b" },
        { "slug": "mist", "name": "Nền xanh nhạt", "color": "#eff4ef" },
        { "slug": "ink", "name": "Chữ nội dung", "color": "#253e35" },
        { "slug": "muted", "name": "Chữ phụ", "color": "#607367" },
        { "slug": "line", "name": "Đường viền", "color": "#dce5dd" },
        { "slug": "white", "name": "Trắng", "color": "#ffffff" }
      ]
    },
    "spacing": {
      "units": [ "px", "rem", "%", "vw", "vh" ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "20", "name": "Rất nhỏ", "size": "8px" },
        { "slug": "30", "name": "Nhỏ", "size": "16px" },
        { "slug": "40", "name": "Vừa", "size": "24px" },
        { "slug": "50", "name": "Rộng", "size": "32px" },
        { "slug": "60", "name": "Rất rộng", "size": "clamp(36px, 5vw, 64px)" },
        { "slug": "70", "name": "Khoảng cách phần", "size": "clamp(56px, 7vw, 104px)" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "fontFamily": "\"Be Vietnam Pro\", Arial, sans-serif",
          "slug": "be-vietnam-pro",
          "name": "Be Vietnam Pro",
          "fontFace": [
            { "fontFamily": "Be Vietnam Pro", "fontStyle": "normal", "fontWeight": "400", "src": [ "file:./assets/fonts/be-vietnam-pro-400.ttf" ] },
            { "fontFamily": "Be Vietnam Pro", "fontStyle": "normal", "fontWeight": "600", "src": [ "file:./assets/fonts/be-vietnam-pro-600.ttf" ] },
            { "fontFamily": "Be Vietnam Pro", "fontStyle": "normal", "fontWeight": "700", "src": [ "file:./assets/fonts/be-vietnam-pro-700.ttf" ] },
            { "fontFamily": "Be Vietnam Pro", "fontStyle": "normal", "fontWeight": "800", "src": [ "file:./assets/fonts/be-vietnam-pro-800.ttf" ] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "x-small", "name": "Chú thích", "size": "12px", "fluid": false },
        { "slug": "small", "name": "Nội dung nhỏ", "size": "14px", "fluid": false },
        { "slug": "medium", "name": "Nội dung", "size": "16px", "fluid": false },
        { "slug": "large", "name": "Giới thiệu", "size": "20px", "fluid": { "min": "18px", "max": "20px" } },
        { "slug": "x-large", "name": "Tiêu đề nhỏ", "size": "28px", "fluid": { "min": "23px", "max": "28px" } },
        { "slug": "xx-large", "name": "Tiêu đề phần", "size": "44px", "fluid": { "min": "29px", "max": "44px" } },
        { "slug": "xxx-large", "name": "Tiêu đề trang", "size": "54px", "fluid": { "min": "34px", "max": "54px" } },
        { "slug": "hero", "name": "Tiêu đề trang chủ", "size": "70px", "fluid": { "min": "36px", "max": "70px" } }
      ]
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|white", "text": "var:preset|color|ink" },
    "spacing": { "padding": { "left": "clamp(20px, 4vw, 48px)", "right": "clamp(20px, 4vw, 48px)" }, "blockGap": "24px" },
    "typography": { "fontFamily": "var:preset|font-family|be-vietnam-pro", "fontSize": "16px", "lineHeight": "1.85", "fontWeight": "400" },
    "elements": {
      "link": { "color": { "text": "var:preset|color|leaf" }, "typography": { "textDecoration": "none" }, ":hover": { "color": { "text": "var:preset|color|forest" }, "typography": { "textDecoration": "underline" } } },
      "heading": { "color": { "text": "var:preset|color|forest" }, "typography": { "fontFamily": "var:preset|font-family|be-vietnam-pro", "fontWeight": "600", "lineHeight": "1.3", "letterSpacing": "-0.035em" } },
      "h1": { "typography": { "fontSize": "var:preset|font-size|xxx-large", "lineHeight": "1.2" } },
      "h2": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
      "h4": { "typography": { "fontSize": "var:preset|font-size|large" } },
      "button": { "color": { "background": "var:preset|color|forest", "text": "var:preset|color|white" }, "border": { "radius": "6px" }, "spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "24px", "right": "24px" } }, "typography": { "fontFamily": "inherit", "fontSize": "14px", "fontWeight": "600", "lineHeight": "1.6", "textDecoration": "none" }, ":hover": { "color": { "background": "var:preset|color|leaf", "text": "var:preset|color|white" } } }
    },
    "blocks": {
      "core/group": { "spacing": { "blockGap": "24px" } },
      "core/columns": { "spacing": { "blockGap": "var:preset|spacing|60" } },
      "core/heading": { "spacing": { "margin": { "top": "0", "bottom": "0" } } },
      "core/paragraph": { "spacing": { "margin": { "top": "0", "bottom": "0" } } },
      "core/site-title": { "typography": { "fontSize": "24px", "fontWeight": "700", "lineHeight": "1.2", "letterSpacing": "-0.04em" }, "elements": { "link": { "color": { "text": "inherit" } } } },
      "core/site-tagline": { "typography": { "fontSize": "11px", "lineHeight": "1.5" }, "color": { "text": "var:preset|color|muted" } },
      "core/navigation": { "typography": { "fontSize": "13px", "fontWeight": "600", "lineHeight": "1.6" }, "spacing": { "blockGap": "24px" }, "elements": { "link": { "color": { "text": "inherit" } } } },
      "core/post-title": { "elements": { "link": { "color": { "text": "inherit" } } } },
      "core/post-date": { "color": { "text": "var:preset|color|muted" }, "typography": { "fontSize": "12px" } },
      "core/post-excerpt": { "color": { "text": "var:preset|color|muted" }, "typography": { "fontSize": "14px", "lineHeight": "1.9" } },
      "core/post-terms": { "color": { "text": "var:preset|color|muted" }, "typography": { "fontSize": "12px" } },
      "core/post-featured-image": { "border": { "radius": "10px" } },
      "core/query-pagination": { "spacing": { "blockGap": "12px", "margin": { "top": "48px" } }, "typography": { "fontSize": "14px" } },
      "core/quote": { "border": { "left": { "color": "var:preset|color|leaf", "style": "solid", "width": "3px" } }, "spacing": { "padding": { "left": "24px" } } },
      "core/separator": { "color": { "text": "var:preset|color|line" }, "border": { "width": "0 0 1px" } },
      "core/search": { "elements": { "button": { "border": { "radius": "6px" } } } },
      "core/details": { "border": { "bottom": { "color": "var:preset|color|line", "style": "solid", "width": "1px" } }, "spacing": { "padding": { "top": "20px", "bottom": "20px" } } },
      "core/table": { "typography": { "fontSize": "14px" } }
    }
  },
  "customTemplates": [
    { "name": "page-full-width", "title": "Trang toàn chiều rộng", "postTypes": [ "page" ] }
  ],
  "templateParts": [
    { "name": "header", "title": "Đầu trang", "area": "header" },
    { "name": "footer", "title": "Chân trang", "area": "footer" },
    { "name": "contact", "title": "Tư vấn và yêu cầu báo giá", "area": "uncategorized" }
  ]
}
